# Copy this file to .env and fill in real values before going live.

# Port the server listens on
PORT=3000

# Admin dashboard credentials (HTTP Basic Auth) — change these before launch
ADMIN_USER=admin
ADMIN_PASS=changeme

# Where every submission notification email is sent
NOTIFY_EMAIL=cso@addressgateway.com

# SMTP settings used to send the notification email.
# Any transactional provider works (SendGrid, Resend, Zoho, Office365, Gmail app password, etc).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Address Gateway Opportunities Hub" <no-reply@addressgateway.com>

# Public base URL of the site (used in email links back to the admin dashboard)
SITE_URL=https://growthaccelerator.addressgateway.com
